{
  "name": "pfeifer-hurl",
  "displayName": "Hurl",
  "description": "Tree-sitter syntax highlighting and language configuration for Hurl files",
  "version": "1.4.2",
  "license": "Apache-2.0",
  "author": "Jacob Pfeifer",
  "publisher": "JacobPfeifer",
  "repository": {
    "type": "git",
    "url": "https://github.com/pfeiferj/vscode-hurl"
  },
  "icon": "hurl-icon.png",
  "engines": {
    "vscode": "^1.142.0"
  },
  "categories": [
    "programming languages"
  ],
  "activationEvents": [
    "onLanguage:hurl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[hurl]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "languages": [
      {
        "id": "hurl",
        "extensions": [
          ".hurl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "hurlMethod",
        "superType": "method",
        "description": "Hurl HTTP request method"
      },
      {
        "id": "hurlEscape",
        "superType": "string",
        "description": "Hurl string escape or XML entity reference"
      },
      {
        "id": "hurlBoolean",
        "superType": "keyword",
        "description": "Hurl or JSON boolean literal"
      },
      {
        "id": "hurlOption",
        "superType": "property",
        "description": "Hurl option name or verbosity level"
      },
      {
        "id": "punctuationBracket",
        "description": "Hurl, JSON or XML structural bracket"
      },
      {
        "id": "punctuationDelimiter",
        "description": "Hurl, JSON or XML punctuation separator"
      },
      {
        "id": "punctuationSpecial",
        "description": "Hurl variable interpolation delimiter"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "hurl",
        "scopes": {
          "hurlMethod": [
            "keyword.control.http-method.hurl"
          ],
          "hurlEscape": [
            "constant.character.escape.hurl"
          ],
          "hurlBoolean": [
            "constant.language.boolean.hurl"
          ],
          "hurlOption": [
            "support.constant.option.hurl"
          ],
          "punctuationBracket": [
            "punctuation.section.brackets.hurl"
          ],
          "punctuationDelimiter": [
            "punctuation.separator.hurl"
          ],
          "punctuationSpecial": [
            "punctuation.section.interpolation.hurl"
          ],
          "variable.declaration": [
            "variable.other.readwrite.hurl"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc --watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node --test out/test/*.test.js",
    "test:integration": "node out/test/runTest.js",
    "package": "vsce package --out hurl.vsix",
    "verify:package": "npm run package && node scripts/verify-package.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.13.0",
    "typescript": "^7.0.2",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@types/emscripten": "^1.41.6"
  },
  "dependencies": {
    "@lumis-sh/wasm-graphql": "0.26.3",
    "@lumis-sh/wasm-json": "0.26.5",
    "@lumis-sh/wasm-xml": "0.26.4",
    "web-tree-sitter": "^0.27.1"
  }
}

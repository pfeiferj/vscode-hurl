{
  "name": "pfeifer-hurl",
  "displayName": "Hurl",
  "description": "Tree-sitter syntax highlighting and language configuration for Hurl files",
  "version": "1.4.2",
  "license": "Apache-2.0",
  "author": "Jacob Pfeifer",
  "publisher": "JacobPfeifer",
  "repository": {
    "type": "git",
    "url": "https://github.com/pfeiferj/vscode-hurl"
  },
  "icon": "hurl-icon.png",
  "engines": {
    "vscode": "^1.142.0"
  },
  "categories": [
    "programming languages"
  ],
  "activationEvents": [
    "onLanguage:hurl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "hurl",
        "extensions": [
          ".hurl"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc --watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node --test out/test/highlighting.test.js",
    "test:integration": "node out/test/runTest.js",
    "package": "vsce package --out hurl.vsix",
    "verify:package": "npm run package && node scripts/verify-package.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.13.0",
    "typescript": "^7.0.2",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@types/emscripten": "^1.41.6"
  },
  "dependencies": {
    "web-tree-sitter": "^0.27.1"
  }
}
